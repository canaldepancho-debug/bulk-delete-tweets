{
  "manifest_version": 3,
  "name": "X (Twitter) Post Cleaner",
  "version": "1.0",
  "description": "Automatically delete posts, retweets, and replies on X (Twitter) based on conditions.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://x.com/*",
    "*://*.x.com/*",
    "*://twitter.com/*",
    "*://*.twitter.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Post Cleaner"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://twitter.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
